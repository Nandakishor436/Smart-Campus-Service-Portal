@{
    ViewBag.Title = "Campus Contact Directory";
}

<section class="py-5 bg-light border-bottom">
    <div class="container text-center py-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-uppercase mb-2">Helpdesk & Support</span>
        <h1 class="fw-bolder display-5">Campus Contact Directory</h1>
        <p class="lead text-muted max-w-2xl mx-auto">
            Get in touch with campus department administrators, helpdesk personnel, and academic coordinators.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm" style="border-radius: 16px;">
                    <div class="stat-icon blue mb-3" style="width: 48px; height: 48px;"><i class="fa-solid fa-headset"></i></div>
                    <h5 class="fw-bold">IT Helpdesk & Support</h5>
                    <p class="text-muted small">Assistance with WiFi authentication, lab accounts, and portal login issues.</p>
                    <hr>
                    <p class="mb-1 small"><strong>Email:</strong> ithelpdesk@campus.edu</p>
                    <p class="mb-1 small"><strong>Phone:</strong> +1 (555) 019-2831</p>
                    <p class="mb-0 small"><strong>Location:</strong> Tech Block, Room 101</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm" style="border-radius: 16px;">
                    <div class="stat-icon purple mb-3" style="width: 48px; height: 48px;"><i class="fa-solid fa-graduation-cap"></i></div>
                    <h5 class="fw-bold">Academic Office & Registrar</h5>
                    <p class="text-muted small">Issuance of bonafide certificates, official transcripts, and grade sheets.</p>
                    <hr>
                    <p class="mb-1 small"><strong>Email:</strong> registrar@campus.edu</p>
                    <p class="mb-1 small"><strong>Phone:</strong> +1 (555) 019-2832</p>
                    <p class="mb-0 small"><strong>Location:</strong> Administrative Building, Ground Floor</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm" style="border-radius: 16px;">
                    <div class="stat-icon amber mb-3" style="width: 48px; height: 48px;"><i class="fa-solid fa-hotel"></i></div>
                    <h5 class="fw-bold">Hostel & Student Housing</h5>
                    <p class="text-muted small">Room allocations, night outpasses, mess complaints, and maintenance.</p>
                    <hr>
                    <p class="mb-1 small"><strong>Email:</strong> chiefwarden@campus.edu</p>
                    <p class="mb-1 small"><strong>Phone:</strong> +1 (555) 019-2833</p>
                    <p class="mb-0 small"><strong>Location:</strong> Central Hostel Office, Block C</p>
                </div>
            </div>
        </div>

        <div class="card mt-5 p-4 border-0 shadow-sm bg-white" style="border-radius: 16px;">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h4 class="fw-bold mb-2">Have a specific service request or complaint?</h4>
                    <p class="text-muted mb-0">Log in to the Smart Campus Service Portal to submit a tracked service ticket with instant notifications and status history.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg fw-bold px-4">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> Submit Request
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
