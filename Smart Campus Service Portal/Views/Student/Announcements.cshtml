@model List<Smart_Campus_Service_Portal.Models.Announcement>
@{
    ViewBag.Title = "Campus Announcements & Notices";
}

<div class="page-header">
    <div class="page-title">
        <h2>Campus Announcements & Notice Board</h2>
        <p>Official circulars, exam notifications, hackathons, and administrative announcements</p>
    </div>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var a in Model)
        {
            string borderClass = "border-primary";
            string badgeClass = "bg-primary";
            if (a.Priority == "Urgent") { borderClass = "border-danger"; badgeClass = "bg-danger"; }
            else if (a.Priority == "High") { borderClass = "border-warning"; badgeClass = "bg-warning text-dark"; }

            <div class="col-md-6">
                <div class="card-panel h-100 border-start-4 @borderClass">
                    <div class="card-panel-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge @badgeClass text-uppercase fw-bold" style="font-size: 0.72rem;">@a.Priority Notice</span>
                            <span class="text-muted small">@a.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">@a.Title</h5>
                        <span class="badge bg-light text-dark border mb-3">@a.Category</span>
                        <p class="text-secondary small leading-relaxed mb-3">@a.Content</p>
                        <div class="border-top pt-2 small text-muted">
                            <i class="fa-solid fa-user-pen me-1 text-primary"></i> Issued by <strong>@a.AuthorName</strong>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="fa-solid fa-bullhorn text-muted display-4 mb-3"></i>
            <h5 class="fw-bold">No active campus notices</h5>
            <p class="text-muted small">All clear! Check back later for new updates.</p>
        </div>
    }
</div>
