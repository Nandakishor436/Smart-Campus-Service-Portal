@model Smart_Campus_Service_Portal.Models.ViewModels.StudentDashboardViewModel
@{
    ViewBag.Title = "Student Dashboard";
}

<!-- Welcome Banner -->
<div class="card-panel border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #ffffff;">
    <div class="card-panel-body p-4 p-md-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-1 mb-2 fw-bold text-uppercase">Student Portal</span>
                <h2 class="fw-bolder mb-1 text-white">Hello, @(Model.User?.FullName ?? "Student")!</h2>
                <p class="text-white-50 mb-3">
                    Roll No: <strong class="text-white">@(Model.Student?.RollNumber ?? "N/A")</strong> &bull;
                    Department: <strong class="text-white">@(Model.Student?.Department ?? "General")</strong> &bull;
                    Semester: <strong class="text-white">@(Model.Student?.Semester.ToString() ?? "1")</strong>
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Services", "Student")" class="btn btn-primary btn-sm fw-bold px-3">
                        <i class="fa-solid fa-plus me-1"></i> New Service Request
                    </a>
                    <a href="@Url.Action("Complaints", "Student")" class="btn btn-outline-light btn-sm fw-bold px-3">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Lodge Complaint
                    </a>
                    <a href="@Url.Action("Feedback", "Student")" class="btn btn-outline-light btn-sm fw-bold px-3">
                        <i class="fa-solid fa-star me-1"></i> Rate Services
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0 d-none d-lg-block">
                <div class="brand-icon mx-auto me-lg-0" style="width: 80px; height: 80px; font-size: 2.5rem; background: rgba(59, 130, 246, 0.2); border: 2px solid rgba(59, 130, 246, 0.4);">
                    <i class="fa-solid fa-user-graduate text-primary"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon blue mb-2" style="width: 40px; height: 40px; font-size: 1.1rem;"><i class="fa-solid fa-clipboard-list"></i></div>
            <div class="stat-title">Total Requests</div>
            <h3 class="stat-value">@Model.TotalRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon amber mb-2" style="width: 40px; height: 40px; font-size: 1.1rem;"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="stat-title">Pending</div>
            <h3 class="stat-value text-warning">@Model.PendingRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon cyan mb-2" style="width: 40px; height: 40px; font-size: 1.1rem;"><i class="fa-solid fa-spinner fa-spin"></i></div>
            <div class="stat-title">In Progress</div>
            <h3 class="stat-value text-info">@Model.InProgressRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon green mb-2" style="width: 40px; height: 40px; font-size: 1.1rem;"><i class="fa-solid fa-circle-check"></i></div>
            <div class="stat-title">Completed</div>
            <h3 class="stat-value text-success">@Model.CompletedRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon rose mb-2" style="width: 40px; height: 40px; font-size: 1.1rem;"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="stat-title">Rejected</div>
            <h3 class="stat-value text-danger">@Model.RejectedRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon purple mb-2" style="width: 40px; height: 40px; font-size: 1.1rem;"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="stat-title">Complaints</div>
            <h3 class="stat-value">@Model.TotalComplaints</h3>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Requests -->
    <div class="col-lg-8">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-clock-rotate-left"></i> Recent Service Requests
                </h5>
                <a href="@Url.Action("MyRequests", "Student")" class="btn btn-sm btn-outline-primary fw-bold">View All</a>
            </div>
            <div class="card-panel-body p-0">
                @if (Model.RecentRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Tracking ID</th>
                                    <th>Service Name</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Submitted</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.RecentRequests)
                                {
                                    string badgeClass = "badge-status-pending";
                                    if (r.Status == "In Progress") { badgeClass = "badge-status-inprogress"; }
                                    else if (r.Status == "Approved") { badgeClass = "badge-status-approved"; }
                                    else if (r.Status == "Completed") { badgeClass = "badge-status-completed"; }
                                    else if (r.Status == "Rejected") { badgeClass = "badge-status-rejected"; }

                                    <tr>
                                        <td>
                                            <a href="@Url.Action("RequestDetails", "Student", new { id = r.Id })" class="fw-bold text-primary font-monospace">
                                                @r.RequestNumber
                                            </a>
                                        </td>
                                        <td><strong>@r.ServiceName</strong></td>
                                        <td><span class="badge bg-light text-dark border">@r.ServiceCategory</span></td>
                                        <td><span class="badge-status @badgeClass">@r.Status</span></td>
                                        <td class="text-muted small">@r.SubmissionDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <a href="@Url.Action("RequestDetails", "Student", new { id = r.Id })" class="btn btn-sm btn-light" title="View Tracking Timeline">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Voucher", "Student", new { id = r.Id })" class="btn btn-sm btn-light" title="Print/Download Voucher" target="_blank">
                                                <i class="fa-solid fa-print"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-inbox text-muted display-4 mb-3"></i>
                        <h6 class="fw-bold">No requests submitted yet</h6>
                        <p class="text-muted small">Browse campus services and apply online in seconds.</p>
                        <a href="@Url.Action("Services", "Student")" class="btn btn-primary btn-sm fw-bold">Explore Campus Services</a>
                    </div>
                }
            </div>
        </div>

        <!-- Featured Services Quick Access -->
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-bolt text-warning"></i> Quick Access Services
                </h5>
                <a href="@Url.Action("Services", "Student")" class="btn btn-sm btn-outline-primary fw-bold">All Services</a>
            </div>
            <div class="card-panel-body">
                <div class="row g-3">
                    @foreach (var s in Model.FeaturedServices)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="p-3 border rounded h-100 d-flex flex-column justify-content-between hover-shadow">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="stat-icon blue" style="width: 34px; height: 34px; font-size: 1rem;"><i class="fa-solid @s.Icon"></i></div>
                                        <h6 class="fw-bold mb-0">@s.Name</h6>
                                    </div>
                                    <p class="text-muted small mb-3" style="font-size: 0.82rem;">@s.Description</p>
                                </div>
                                <a href="@Url.Action("ApplyService", "Student", new { id = s.Id })" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                                    Apply Now &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Announcements & Notifications -->
    <div class="col-lg-4">
        <!-- Announcements -->
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-bullhorn text-danger"></i> Campus Notices
                </h5>
                <a href="@Url.Action("Announcements", "Student")" class="btn btn-sm btn-link text-primary p-0">View all</a>
            </div>
            <div class="card-panel-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.RecentAnnouncements)
                    {
                        <div class="list-group-item p-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-dark border">@a.Category</span>
                                <small class="text-muted" style="font-size: 0.72rem;">@a.CreatedAt.ToString("MMM dd")</small>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.9rem;">@a.Title</h6>
                            <p class="text-muted small mb-0" style="font-size: 0.8rem;">@(a.Content.Length > 90 ? a.Content.Substring(0, 90) + "..." : a.Content)</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Notifications -->
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-bell text-info"></i> Recent Alerts
                </h5>
                <a href="@Url.Action("Notifications", "Student")" class="btn btn-sm btn-link text-primary p-0">All Alerts</a>
            </div>
            <div class="card-panel-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var n in Model.Notifications)
                    {
                        <a href="@(string.IsNullOrEmpty(n.Link) ? "#" : n.Link)" class="list-group-item list-group-item-action p-3">
                            <div class="d-flex gap-2">
                                <i class="fa-solid fa-circle-info text-primary mt-1"></i>
                                <div>
                                    <div class="fw-bold small text-dark">@n.Title</div>
                                    <div class="text-muted" style="font-size: 0.78rem;">@n.Message</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@n.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
