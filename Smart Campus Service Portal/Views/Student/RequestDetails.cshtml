@model Smart_Campus_Service_Portal.Models.ViewModels.ServiceRequestDetailViewModel
@{
    var r = Model.Request;
    ViewBag.Title = $"Request Details - {r.RequestNumber}";

    string badgeClass = "badge-status-pending";
    if (r.Status == "In Progress") { badgeClass = "badge-status-inprogress"; }
    else if (r.Status == "Approved") { badgeClass = "badge-status-approved"; }
    else if (r.Status == "Completed") { badgeClass = "badge-status-completed"; }
    else if (r.Status == "Rejected") { badgeClass = "badge-status-rejected"; }
}

<div class="page-header">
    <div class="page-title">
        <a href="@Url.Action("MyRequests", "Student")" class="small text-muted text-decoration-none mb-1 d-inline-block">
            &larr; Back to My Requests
        </a>
        <div class="d-flex align-items-center gap-3">
            <h2>@r.RequestNumber</h2>
            <span class="badge-status @badgeClass fs-6">@r.Status</span>
        </div>
        <p>Submitted on @r.SubmissionDate.ToString("MMMM dd, yyyy 'at' hh:mm tt") for <strong>@r.ServiceName</strong></p>
    </div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("Voucher", "Student", new { id = r.Id })" class="btn btn-outline-dark fw-bold shadow-sm" target="_blank">
            <i class="fa-solid fa-print me-1"></i> Printable Voucher Slip
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Form Details & Request Summary -->
    <div class="col-lg-7">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-file-lines text-primary"></i> Application Submission Details
                </h5>
            </div>
            <div class="card-panel-body">
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <small class="text-secondary fw-bold text-uppercase d-block" style="font-size: 0.72rem;">Service Name</small>
                        <span class="fw-bold fs-6">@r.ServiceName</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-secondary fw-bold text-uppercase d-block" style="font-size: 0.72rem;">Category</small>
                        <span class="badge bg-light text-dark border">@r.ServiceCategory</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-secondary fw-bold text-uppercase d-block" style="font-size: 0.72rem;">Student Name & Roll No</small>
                        <span class="fw-semibold">@r.StudentName (@r.StudentRollNo)</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-secondary fw-bold text-uppercase d-block" style="font-size: 0.72rem;">Department</small>
                        <span class="fw-semibold">@r.Department</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-secondary fw-bold text-uppercase d-block" style="font-size: 0.72rem;">Priority Level</small>
                        <span class="badge bg-secondary">@r.Priority</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-secondary fw-bold text-uppercase d-block" style="font-size: 0.72rem;">Assigned Staff / Faculty</small>
                        <span class="fw-semibold text-primary">@(r.AssignedToName ?? "Pending Assignment")</span>
                    </div>
                </div>

                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Submitted Form Information</h6>
                @if (r.FormDetails != null && r.FormDetails.Any())
                {
                    <table class="table table-bordered small">
                        <tbody>
                            @foreach (var entry in r.FormDetails)
                            {
                                <tr>
                                    <th class="bg-light text-secondary" style="width: 35%;">@entry.Key</th>
                                    <td class="text-dark fw-semibold">@entry.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted small">No dynamic form details recorded.</p>
                }

                @if (!string.IsNullOrEmpty(r.Remarks))
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        <strong class="d-block small text-secondary mb-1">Administrative Remarks / Notes:</strong>
                        <p class="mb-0 text-dark">@r.Remarks</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Status Timeline Tracking -->
    <div class="col-lg-5">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-route text-success"></i> Status Tracking Timeline
                </h5>
            </div>
            <div class="card-panel-body">
                <div class="tracking-timeline">
                    @if (r.StatusHistory != null && r.StatusHistory.Any())
                    {
                        for (int i = 0; i < r.StatusHistory.Count; i++)
                        {
                            var item = r.StatusHistory[i];
                            bool isLast = (i == r.StatusHistory.Count - 1);
                            string stepClass = isLast ? "active" : "completed";

                            <div class="timeline-step @stepClass">
                                <div class="timeline-step-icon">
                                    <i class="fa-solid @(isLast ? "fa-circle-dot" : "fa-check")"></i>
                                </div>
                                <div class="timeline-step-content">
                                    <div class="timeline-step-header">
                                        <h6 class="timeline-step-title">@item.Status</h6>
                                        <span class="timeline-step-time">@item.Timestamp.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                    <div class="small text-muted mb-1">
                                        Updated by <strong>@item.ChangedBy</strong> (@item.Role)
                                    </div>
                                    <p class="timeline-step-note">@item.Comment</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="timeline-step active">
                            <div class="timeline-step-icon"><i class="fa-solid fa-check"></i></div>
                            <div class="timeline-step-content">
                                <h6 class="timeline-step-title">Submitted</h6>
                                <p class="timeline-step-note">Application received by portal.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
