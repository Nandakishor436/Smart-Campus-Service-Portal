@model List<Smart_Campus_Service_Portal.Models.ServiceRequest>
@{
    ViewBag.Title = "My Service Requests";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    string searchTerm = ViewBag.SearchTerm as string;
}

<div class="page-header">
    <div class="page-title">
        <h2>My Submitted Requests</h2>
        <p>Track the real-time status and lifecycle of your campus service applications</p>
    </div>
    <a href="@Url.Action("Services", "Student")" class="btn btn-primary fw-bold shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> New Request
    </a>
</div>

<!-- Filters -->
<div class="card-panel mb-4">
    <div class="card-panel-body py-3">
        <form method="get" action="@Url.Action("MyRequests", "Student")" class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by request number or service name..." value="@searchTerm" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="All" @(selectedStatus == "All" ? "selected" : "")>All Statuses</option>
                    <option value="Pending" @(selectedStatus == "Pending" ? "selected" : "")>Pending</option>
                    <option value="In Progress" @(selectedStatus == "In Progress" ? "selected" : "")>In Progress</option>
                    <option value="Approved" @(selectedStatus == "Approved" ? "selected" : "")>Approved</option>
                    <option value="Completed" @(selectedStatus == "Completed" ? "selected" : "")>Completed</option>
                    <option value="Rejected" @(selectedStatus == "Rejected" ? "selected" : "")>Rejected</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Requests Table -->
<div class="card-panel">
    <div class="card-panel-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Tracking ID</th>
                            <th>Service Name</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted On</th>
                            <th>Assigned Staff</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            string badgeClass = "badge-status-pending";
                            if (r.Status == "In Progress") { badgeClass = "badge-status-inprogress"; }
                            else if (r.Status == "Approved") { badgeClass = "badge-status-approved"; }
                            else if (r.Status == "Completed") { badgeClass = "badge-status-completed"; }
                            else if (r.Status == "Rejected") { badgeClass = "badge-status-rejected"; }

                            string priorityBadge = "badge-priority-medium";
                            if (r.Priority == "Low") { priorityBadge = "badge-priority-low"; }
                            else if (r.Priority == "High") { priorityBadge = "badge-priority-high"; }
                            else if (r.Priority == "Urgent") { priorityBadge = "badge-priority-urgent"; }

                            <tr>
                                <td>
                                    <a href="@Url.Action("RequestDetails", "Student", new { id = r.Id })" class="fw-bold text-primary font-monospace">
                                        @r.RequestNumber
                                    </a>
                                </td>
                                <td><strong>@r.ServiceName</strong></td>
                                <td><span class="badge bg-light text-dark border">@r.ServiceCategory</span></td>
                                <td><span class="badge @priorityBadge">@r.Priority</span></td>
                                <td><span class="badge-status @badgeClass">@r.Status</span></td>
                                <td class="text-muted small">@r.SubmissionDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="small text-secondary">@(r.AssignedToName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("RequestDetails", "Student", new { id = r.Id })" class="btn btn-light" title="View Tracking & Timeline">
                                            <i class="fa-solid fa-eye text-primary"></i> Track
                                        </a>
                                        <a href="@Url.Action("Voucher", "Student", new { id = r.Id })" class="btn btn-light" title="Print/Download Voucher" target="_blank">
                                            <i class="fa-solid fa-print text-secondary"></i> Slip
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-inbox text-muted display-4 mb-3"></i>
                <h5 class="fw-bold">No service requests found</h5>
                <p class="text-muted small">You haven't submitted any service requests under this filter yet.</p>
                <a href="@Url.Action("Services", "Student")" class="btn btn-primary btn-sm fw-bold">Browse Campus Services</a>
            </div>
        }
    </div>
</div>
