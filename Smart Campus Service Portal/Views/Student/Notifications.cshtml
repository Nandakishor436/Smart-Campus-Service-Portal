@model List<Smart_Campus_Service_Portal.Models.Notification>
@{
    ViewBag.Title = "Notifications Center";
}

<div class="page-header">
    <div class="page-title">
        <h2>Notifications & Alerts Center</h2>
        <p>Real-time updates regarding your service requests and complaint resolutions</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-bell text-primary"></i> Notification Feed
                </h5>
            </div>
            <div class="card-panel-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model)
                        {
                            string icon = "fa-circle-info text-info";
                            if (n.Type == "success") { icon = "fa-circle-check text-success"; }
                            else if (n.Type == "warning") { icon = "fa-triangle-exclamation text-warning"; }
                            else if (n.Type == "danger") { icon = "fa-circle-xmark text-danger"; }

                            <div class="list-group-item p-3 border-bottom @(!n.IsRead ? "bg-light" : "")">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="fa-solid @icon fs-4 mt-1"></i>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="fw-bold mb-0 text-dark">@n.Title</h6>
                                            <span class="text-muted small" style="font-size: 0.72rem;">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                        </div>
                                        <p class="text-secondary small mb-2">@n.Message</p>
                                        @if (!string.IsNullOrEmpty(n.Link))
                                        {
                                            <a href="@n.Link" class="btn btn-sm btn-outline-primary fw-bold" style="font-size: 0.78rem;">
                                                View Details &rarr;
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-regular fa-bell-slash text-muted display-4 mb-3"></i>
                        <h6 class="fw-bold">No notifications yet</h6>
                        <p class="text-muted small">You will receive notifications when requests are updated.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
