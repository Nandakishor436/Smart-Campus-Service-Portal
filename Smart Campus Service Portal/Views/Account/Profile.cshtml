@model Smart_Campus_Service_Portal.Models.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "My Profile";
}

<div class="page-header">
    <div class="page-title">
        <h2>My User Profile</h2>
        <p>Manage your campus identity, contact credentials, and departmental affiliations</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card-panel text-center">
            <div class="card-panel-body py-5">
                <div class="user-avatar mx-auto mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem;">
                    @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2">@Model.Email</p>
                <span class="user-role-pill role-@(Model.Role.ToLower()) px-3 py-1 fs-6">@Model.Role</span>

                <hr class="my-4">

                <div class="text-start">
                    <div class="mb-2 small">
                        <strong class="text-secondary">Identifier:</strong>
                        <span class="float-end fw-semibold">@Model.Identifier</span>
                    </div>
                    <div class="mb-2 small">
                        <strong class="text-secondary">Department:</strong>
                        <span class="float-end fw-semibold">@Model.Department</span>
                    </div>
                    @if (Model.Role == "Student")
                    {
                        <div class="mb-2 small">
                            <strong class="text-secondary">Degree:</strong>
                            <span class="float-end fw-semibold">@Model.Degree</span>
                        </div>
                        <div class="mb-2 small">
                            <strong class="text-secondary">Semester:</strong>
                            <span class="float-end fw-semibold">Semester @Model.Semester</span>
                        </div>
                    }
                    else if (Model.Role == "Faculty")
                    {
                        <div class="mb-2 small">
                            <strong class="text-secondary">Designation:</strong>
                            <span class="float-end fw-semibold">@Model.Designation</span>
                        </div>
                    }
                </div>

                <div class="mt-4 pt-2">
                    <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary w-100 btn-sm fw-bold">
                        <i class="fa-solid fa-key me-2"></i> Change Password
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-user-pen"></i> Edit Personal & Contact Details
                </h5>
            </div>
            <div class="card-panel-body">
                @using (Html.BeginForm("Profile", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Full Name</label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Email Address (Read-only)</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light", @readonly = "readonly" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Contact Phone Number</label>
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "+1 555-019-2831" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Department (Read-only)</label>
                            @Html.TextBoxFor(m => m.Department, new { @class = "form-control bg-light", @readonly = "readonly" })
                        </div>

                        @if (Model.Role == "Student")
                        {
                            <div class="col-12">
                                <label class="form-label fw-bold small text-secondary">Hostel / Residential Address</label>
                                @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Hostel room or local residence" })
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-secondary">Emergency Contact Information</label>
                                @Html.TextBoxFor(m => m.EmergencyContact, new { @class = "form-control", placeholder = "Parent / Guardian Name & Phone" })
                            </div>
                        }
                        else if (Model.Role == "Faculty")
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-secondary">Office Room / Cabin</label>
                                @Html.TextBoxFor(m => m.OfficeRoom, new { @class = "form-control", placeholder = "e.g. CS Block Room 304" })
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-2"></i> Save Profile Changes
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
