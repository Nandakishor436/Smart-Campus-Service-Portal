@model List<Smart_Campus_Service_Portal.Models.Complaint>
@{
    ViewBag.Title = "Complaint Management Center";
    var facultyUsers = ViewBag.FacultyUsers as List<Smart_Campus_Service_Portal.Models.User> ?? new List<Smart_Campus_Service_Portal.Models.User>();
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    string selectedCategory = ViewBag.SelectedCategory as string ?? "All";
    string searchTerm = ViewBag.SearchTerm as string;
}

<div class="page-header">
    <div class="page-title">
        <h2>Campus Grievance & Complaints Oversight</h2>
        <p>Monitor student grievance tickets, assign officers, record resolutions, and enforce SLAs</p>
    </div>
</div>

<!-- Filters -->
<div class="card-panel mb-4">
    <div class="card-panel-body py-3">
        <form method="get" action="@Url.Action("Complaints", "Admin")" class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search ticket number, student, subject..." value="@searchTerm" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="All" @(selectedStatus == "All" ? "selected" : "")>All Ticket Statuses</option>
                    <option value="Open" @(selectedStatus == "Open" ? "selected" : "")>Open</option>
                    <option value="Under Review" @(selectedStatus == "Under Review" ? "selected" : "")>Under Review</option>
                    <option value="In Progress" @(selectedStatus == "In Progress" ? "selected" : "")>In Progress</option>
                    <option value="Resolved" @(selectedStatus == "Resolved" ? "selected" : "")>Resolved</option>
                    <option value="Closed" @(selectedStatus == "Closed" ? "selected" : "")>Closed</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Complaints Feed -->
<div class="card-panel">
    <div class="card-panel-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var c in Model)
                {
                    string badgeClass = "badge-status-pending";
                    if (c.Status == "Under Review" || c.Status == "In Progress") { badgeClass = "badge-status-inprogress"; }
                    else if (c.Status == "Resolved" || c.Status == "Closed") { badgeClass = "badge-status-completed"; }

                    <div class="list-group-item p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="font-monospace fw-bold text-primary">@c.ComplaintNumber</span>
                                <span class="badge bg-light text-dark border">@c.Category</span>
                                <span class="badge bg-secondary">Priority: @c.Priority</span>
                            </div>
                            <span class="badge-status @badgeClass">@c.Status</span>
                        </div>

                        <h5 class="fw-bold text-dark mb-1">@c.Subject</h5>
                        <p class="text-secondary small mb-3">@c.Description</p>

                        <div class="row g-2 mb-3 small text-muted">
                            <div class="col-sm-3"><strong>Applicant:</strong> @c.StudentName (@c.StudentRollNo)</div>
                            <div class="col-sm-3"><strong>Location:</strong> @c.Location</div>
                            <div class="col-sm-3"><strong>Assigned To:</strong> @(c.AssignedToName ?? "Unassigned")</div>
                            <div class="col-sm-3"><strong>Submitted:</strong> @c.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </div>

                        @if (!string.IsNullOrEmpty(c.OfficialResponse))
                        {
                            <div class="alert alert-success small mb-3">
                                <strong>Official Response:</strong> @c.OfficialResponse
                            </div>
                        }

                        <!-- Action Bar -->
                        <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-2 align-items-center justify-content-between">
                            <!-- Assign Officer -->
                            <div class="d-flex align-items-center gap-2">
                                @using (Html.BeginForm("AssignComplaint", "Admin", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="complaintId" value="@c.Id" />
                                    <select name="facultyId" class="form-select form-select-sm" style="width: 220px;" required>
                                        <option value="">-- Assign Faculty/Staff --</option>
                                        @foreach (var fu in facultyUsers)
                                        {
                                            <option value="@fu.Id" @(c.AssignedToId == fu.Id ? "selected" : "")>@fu.FullName</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary fw-bold">Assign</button>
                                }
                            </div>

                            <!-- Resolve Modal Button -->
                            <button class="btn btn-sm btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#resolveModal_@c.Id">
                                <i class="fa-solid fa-check me-1"></i> Resolve Ticket
                            </button>
                        </div>
                    </div>

                    <!-- Resolve Modal -->
                    <div class="modal fade" id="resolveModal_@c.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                @using (Html.BeginForm("ResolveComplaint", "Admin", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="complaintId" value="@c.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">Resolve Complaint: @c.ComplaintNumber</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Official Resolution Message *</label>
                                            <textarea name="officialResponse" class="form-control" rows="3" placeholder="Describe the resolution or action taken..." required></textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Resolution Status</label>
                                            <select name="status" class="form-select">
                                                <option value="Resolved" selected>Resolved</option>
                                                <option value="Closed">Closed</option>
                                                <option value="In Progress">In Progress (Work ongoing)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-success fw-bold">Submit Resolution</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-circle-check text-success display-4 mb-3"></i>
                <h5 class="fw-bold">No complaints found</h5>
                <p class="text-muted small">No complaints matched the selected status filter.</p>
            </div>
        }
    </div>
</div>
