@model Smart_Campus_Service_Portal.Models.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "Administrator Executive Dashboard";
}

<!-- Dashboard Header -->
<div class="page-header">
    <div class="page-title">
        <h2>Executive Campus Operations Dashboard</h2>
        <p>Live metrics, service delivery analytics, and university infrastructure management</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportRequestsCsv", "Admin")" class="btn btn-outline-primary fw-bold">
            <i class="fa-solid fa-file-csv me-1"></i> Export Requests CSV
        </a>
        <a href="@Url.Action("Reports", "Admin")" class="btn btn-primary fw-bold shadow-sm">
            <i class="fa-solid fa-chart-line me-1"></i> Full Reports
        </a>
    </div>
</div>

<!-- Key Performance Indicators (KPIs) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon blue mb-2" style="width: 42px; height: 42px;"><i class="fa-solid fa-user-graduate"></i></div>
            <div class="stat-title">Students</div>
            <h3 class="stat-value">@Model.TotalStudents</h3>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon green mb-2" style="width: 42px; height: 42px;"><i class="fa-solid fa-chalkboard-user"></i></div>
            <div class="stat-title">Faculty</div>
            <h3 class="stat-value">@Model.TotalFaculty</h3>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon purple mb-2" style="width: 42px; height: 42px;"><i class="fa-solid fa-layer-group"></i></div>
            <div class="stat-title">Services</div>
            <h3 class="stat-value">@Model.TotalServices</h3>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon amber mb-2" style="width: 42px; height: 42px;"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="stat-title">Pending</div>
            <h3 class="stat-value text-warning">@Model.PendingRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon cyan mb-2" style="width: 42px; height: 42px;"><i class="fa-solid fa-circle-check"></i></div>
            <div class="stat-title">Completed</div>
            <h3 class="stat-value text-success">@Model.CompletedRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon rose mb-2" style="width: 42px; height: 42px;"><i class="fa-solid fa-star"></i></div>
            <div class="stat-title">Rating</div>
            <h3 class="stat-value text-primary">@Model.AverageFeedbackRating<small class="fs-6 text-muted">/5</small></h3>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Monthly Request Trend Chart -->
    <div class="col-lg-8">
        <div class="card-panel h-100">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-chart-line text-primary"></i> Service Request Volume Trends
                </h5>
                <span class="badge bg-light text-muted border">Last 6 Months</span>
            </div>
            <div class="card-panel-body">
                <canvas id="monthlyTrendChart" height="260"></canvas>
            </div>
        </div>
    </div>

    <!-- Requests by Status Breakdown -->
    <div class="col-lg-4">
        <div class="card-panel h-100">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-chart-pie text-success"></i> Requests by Status
                </h5>
            </div>
            <div class="card-panel-body d-flex flex-column align-items-center justify-content-center">
                <div style="width: 240px; height: 240px;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests by Service Category -->
    <div class="col-lg-6">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-cubes text-info"></i> Requests by Campus Category
                </h5>
            </div>
            <div class="card-panel-body">
                <canvas id="categoryChart" height="220"></canvas>
            </div>
        </div>
    </div>

    <!-- Complaints Breakdown -->
    <div class="col-lg-6">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-triangle-exclamation text-warning"></i> Complaints by Category
                </h5>
            </div>
            <div class="card-panel-body">
                <canvas id="complaintsChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Tables -->
<div class="row g-4">
    <!-- Recent Requests -->
    <div class="col-lg-7">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-list-check text-primary"></i> Recent Campus Requests
                </h5>
                <a href="@Url.Action("Requests", "Admin")" class="btn btn-sm btn-outline-primary fw-bold">Manage All</a>
            </div>
            <div class="card-panel-body p-0">
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Tracking ID</th>
                                <th>Student</th>
                                <th>Service</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RecentRequests)
                            {
                                string badgeClass = "badge-status-pending";
                                if (r.Status == "In Progress") { badgeClass = "badge-status-inprogress"; }
                                else if (r.Status == "Approved") { badgeClass = "badge-status-approved"; }
                                else if (r.Status == "Completed") { badgeClass = "badge-status-completed"; }
                                else if (r.Status == "Rejected") { badgeClass = "badge-status-rejected"; }

                                <tr>
                                    <td class="font-monospace fw-bold text-primary">@r.RequestNumber</td>
                                    <td>
                                        <strong>@r.StudentName</strong>
                                        <small class="text-muted d-block font-monospace">@r.StudentRollNo</small>
                                    </td>
                                    <td>@r.ServiceName</td>
                                    <td><span class="badge-status @badgeClass">@r.Status</span></td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Requests", "Admin", new { search = r.RequestNumber })" class="btn btn-sm btn-light">
                                            <i class="fa-solid fa-sliders text-primary"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Complaints -->
    <div class="col-lg-5">
        <div class="card-panel">
            <div class="card-panel-header">
                <h5 class="card-panel-title">
                    <i class="fa-solid fa-triangle-exclamation text-danger"></i> Recent Complaints
                </h5>
                <a href="@Url.Action("Complaints", "Admin")" class="btn btn-sm btn-outline-danger fw-bold">Manage</a>
            </div>
            <div class="card-panel-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var c in Model.RecentComplaints)
                    {
                        <div class="list-group-item p-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="font-monospace fw-bold text-primary small">@c.ComplaintNumber</span>
                                <span class="badge bg-light text-dark border small">@c.Status</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.88rem;">@c.Subject</h6>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>From @c.StudentName (@c.StudentRollNo)</span>
                                <span>@c.CreatedAt.ToString("MMM dd")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // 1. Monthly Trends Chart
        const trendLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyRequestTrends.Keys));
        const trendData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyRequestTrends.Values));

        new Chart(document.getElementById('monthlyTrendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Service Requests',
                    data: trendData,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.1)',
                    fill: true,
                    tension: 0.35,
                    borderWidth: 3,
                    pointBackgroundColor: '#2563eb',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false } }
                }
            }
        });

        // 2. Status Doughnut Chart
        const statusLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RequestsByStatus.Keys));
        const statusData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RequestsByStatus.Values));

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: ['#f59e0b', '#06b6d4', '#10b981', '#059669', '#ef4444', '#94a3b8']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                cutout: '65%'
            }
        });

        // 3. Category Bar Chart
        const catLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RequestsByCategory.Keys));
        const catData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RequestsByCategory.Values));

        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: catLabels,
                datasets: [{
                    label: 'Requests',
                    data: catData,
                    backgroundColor: '#3b82f6',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false } }
                }
            }
        });

        // 4. Complaints Bar Chart
        const cmpLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ComplaintsByCategory.Keys));
        const cmpData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ComplaintsByCategory.Values));

        new Chart(document.getElementById('complaintsChart'), {
            type: 'bar',
            data: {
                labels: cmpLabels,
                datasets: [{
                    label: 'Complaints',
                    data: cmpData,
                    backgroundColor: '#f59e0b',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
