@model List<Smart_Campus_Service_Portal.Models.ViewModels.UserListItemViewModel>
@{
    ViewBag.Title = "User Management";
    string selectedRole = ViewBag.SelectedRole as string ?? "All";
    string searchTerm = ViewBag.SearchTerm as string;
}

<div class="page-header">
    <div class="page-title">
        <h2>User Account Management</h2>
        <p>Control campus identities, permissions, role authorization, and account activation</p>
    </div>
    <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="fa-solid fa-user-plus me-1"></i> Add New User
    </button>
</div>

<!-- Filters -->
<div class="card-panel mb-4">
    <div class="card-panel-body py-3">
        <form method="get" action="@Url.Action("Users", "Admin")" class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by name, email, or username..." value="@searchTerm" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="role" class="form-select" onchange="this.form.submit()">
                    <option value="All" @(selectedRole == "All" ? "selected" : "")>All User Roles</option>
                    <option value="Student" @(selectedRole == "Student" ? "selected" : "")>Students</option>
                    <option value="Faculty" @(selectedRole == "Faculty" ? "selected" : "")>Faculty</option>
                    <option value="Admin" @(selectedRole == "Admin" ? "selected" : "")>Administrators</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card-panel">
    <div class="card-panel-body p-0">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Email & Contact</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Identifier / ID</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="user-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                        @(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <div>
                                        <strong>@u.FullName</strong>
                                        <small class="text-muted d-block">&#64;@u.Username</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>@u.Email</div>
                                <small class="text-muted">@(u.Phone ?? "No phone")</small>
                            </td>
                            <td>
                                <span class="user-role-pill role-@(u.Role.ToLower())">@u.Role</span>
                            </td>
                            <td>@u.Department</td>
                            <td><span class="font-monospace fw-bold">@u.Identifier</span></td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger fw-bold">Deactivated</span>
                                }
                            </td>
                            <td class="text-muted small">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                @using (Html.BeginForm("ToggleUserStatus", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") fw-bold" onclick="return confirm('Are you sure you want to change activation status for this user?');">
                                        @(u.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("CreateUser", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus text-primary me-2"></i> Create New Campus User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Full Name *</label>
                            <input type="text" name="FullName" class="form-control" required placeholder="e.g. John Doe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Email Address *</label>
                            <input type="email" name="Email" class="form-control" required placeholder="john@campus.edu" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Username *</label>
                            <input type="text" name="Username" class="form-control" required placeholder="john.doe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Initial Password *</label>
                            <input type="password" name="Password" class="form-control" required placeholder="Min 6 characters" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">User Role *</label>
                            <select name="Role" class="form-select" required>
                                <option value="Student">Student</option>
                                <option value="Faculty">Faculty</option>
                                <option value="Admin">Administrator</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Department</label>
                            <input type="text" name="Department" class="form-control" placeholder="Computer Science" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Identifier (Roll No / Employee ID)</label>
                            <input type="text" name="Identifier" class="form-control" placeholder="CS-2026-001" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Create User Account</button>
                </div>
            }
        </div>
    </div>
</div>
