@model List<Smart_Campus_Service_Portal.Models.CampusService>
@{
    ViewBag.Title = "Manage Campus Services";
    string searchTerm = ViewBag.SearchTerm as string;
}

<div class="page-header">
    <div class="page-title">
        <h2>Campus Services Management (CRUD)</h2>
        <p>Define available student and faculty services, SLA turnaround policies, and departmental routing</p>
    </div>
    <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createServiceModal">
        <i class="fa-solid fa-plus me-1"></i> Add New Service
    </button>
</div>

<!-- Services Grid Management -->
<div class="row g-4">
    @foreach (var s in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card-panel h-100 d-flex flex-column justify-content-between">
                <div class="card-panel-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon blue" style="width: 48px; height: 48px; font-size: 1.3rem;">
                            <i class="fa-solid @s.Icon"></i>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge font-monospace bg-light text-dark border">@s.ServiceCode</span>
                            @if (s.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                            }
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-1">@s.Name</h5>
                    <span class="badge bg-light text-primary border mb-2">@s.Category</span>
                    <p class="text-secondary small mb-3">@s.Description</p>

                    <div class="small text-muted mb-2">
                        <strong class="text-dark">Department:</strong> @s.Department
                    </div>
                    <div class="small text-muted">
                        <strong class="text-dark">SLA:</strong> ~@s.EstimatedDays Business Days
                    </div>
                </div>

                <div class="card-panel-footer bg-light p-3 border-top d-flex justify-content-between align-items-center">
                    @using (Html.BeginForm("ToggleServiceStatus", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                            @(s.IsActive ? "Disable" : "Enable")
                        </button>
                    }

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal_@s.Id">
                            <i class="fa-solid fa-pen me-1"></i> Edit
                        </button>

                        @using (Html.BeginForm("DeleteService", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this service?');">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Service Modal -->
        <div class="modal fade" id="editModal_@s.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    @using (Html.BeginForm("EditService", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@s.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i> Edit Campus Service</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Service Code</label>
                                    <input type="text" name="ServiceCode" class="form-control" value="@s.ServiceCode" readonly />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small">Service Name *</label>
                                    <input type="text" name="Name" class="form-control" value="@s.Name" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Category *</label>
                                    <input type="text" name="Category" class="form-control" value="@s.Category" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Managing Department *</label>
                                    <input type="text" name="Department" class="form-control" value="@s.Department" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">FontAwesome Icon Class</label>
                                    <input type="text" name="Icon" class="form-control" value="@s.Icon" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Estimated Days SLA</label>
                                    <input type="number" name="EstimatedDays" class="form-control" value="@s.EstimatedDays" min="1" max="30" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold small">Description *</label>
                                    <textarea name="Description" class="form-control" rows="3" required>@s.Description</textarea>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="activeCheck_@s.Id" @(s.IsActive ? "checked" : "") />
                                        <input type="hidden" name="IsActive" value="false" />
                                        <label class="form-check-label small fw-semibold" for="activeCheck_@s.Id">Service is Active and Available to Students</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary fw-bold">Save Changes</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Create Service Modal -->
<div class="modal fade" id="createServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("CreateService", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus text-primary me-2"></i> Add New Campus Service</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Service Code *</label>
                            <input type="text" name="ServiceCode" class="form-control" placeholder="e.g. SRV-NEW" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small">Service Name *</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Counseling & Wellness Services" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Category *</label>
                            <input type="text" name="Category" class="form-control" placeholder="e.g. Health & Wellness" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Department *</label>
                            <input type="text" name="Department" class="form-control" placeholder="e.g. Student Health Centre" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">FontAwesome Icon Class</label>
                            <input type="text" name="Icon" class="form-control" placeholder="fa-heart-pulse" value="fa-cogs" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Estimated Turnaround Days</label>
                            <input type="number" name="EstimatedDays" class="form-control" value="2" min="1" max="30" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Service Description *</label>
                            <textarea name="Description" class="form-control" rows="3" placeholder="Explain the service scope and workflow..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Create Campus Service</button>
                </div>
            }
        </div>
    </div>
</div>
