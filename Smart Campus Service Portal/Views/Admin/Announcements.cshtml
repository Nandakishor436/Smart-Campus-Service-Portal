@model List<Smart_Campus_Service_Portal.Models.Announcement>
@{
    ViewBag.Title = "Manage Announcements";
}

<div class="page-header">
    <div class="page-title">
        <h2>Campus Announcements & Notice Board (CRUD)</h2>
        <p>Publish university circulars, target specific student or faculty groups, and highlight urgent alerts</p>
    </div>
    <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createNoticeModal">
        <i class="fa-solid fa-plus me-1"></i> Post New Announcement
    </button>
</div>

<div class="row g-4">
    @foreach (var a in Model)
    {
        string borderClass = "border-primary";
        string badgeClass = "bg-primary";
        if (a.Priority == "Urgent") { borderClass = "border-danger"; badgeClass = "bg-danger"; }
        else if (a.Priority == "High") { borderClass = "border-warning"; badgeClass = "bg-warning text-dark"; }

        <div class="col-md-6">
            <div class="card-panel h-100 border-start-4 @borderClass d-flex flex-column justify-content-between">
                <div class="card-panel-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @badgeClass text-uppercase fw-bold" style="font-size: 0.72rem;">@a.Priority</span>
                            <span class="badge bg-light text-dark border">@a.Category</span>
                            <span class="badge bg-secondary-subtle text-secondary">Target: @a.TargetRole</span>
                        </div>
                        <small class="text-muted">@a.CreatedAt.ToString("MMM dd, yyyy")</small>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">@a.Title</h5>
                    <p class="text-secondary small leading-relaxed mb-3">@a.Content</p>

                    <div class="small text-muted">
                        <i class="fa-solid fa-user-pen me-1 text-primary"></i> Author: <strong>@a.AuthorName</strong>
                    </div>
                </div>

                <div class="card-panel-footer bg-light p-3 border-top d-flex justify-content-between align-items-center">
                    <span class="badge @(a.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                        @(a.IsActive ? "Published & Live" : "Draft / Expired")
                    </span>

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal_@a.Id">
                            <i class="fa-solid fa-pen me-1"></i> Edit
                        </button>

                        @using (Html.BeginForm("DeleteAnnouncement", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this announcement?');">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Announcement Modal -->
        <div class="modal fade" id="editModal_@a.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    @using (Html.BeginForm("EditAnnouncement", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@a.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Edit Announcement</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold small">Announcement Title *</label>
                                    <input type="text" name="Title" class="form-control" value="@a.Title" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Category *</label>
                                    <input type="text" name="Category" class="form-control" value="@a.Category" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Target Audience</label>
                                    <select name="TargetRole" class="form-select">
                                        <option value="All" @(a.TargetRole == "All" ? "selected" : "")>All Campus Users</option>
                                        <option value="Student" @(a.TargetRole == "Student" ? "selected" : "")>Students Only</option>
                                        <option value="Faculty" @(a.TargetRole == "Faculty" ? "selected" : "")>Faculty Only</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Priority Level</label>
                                    <select name="Priority" class="form-select">
                                        <option value="Low" @(a.Priority == "Low" ? "selected" : "")>Low</option>
                                        <option value="Medium" @(a.Priority == "Medium" ? "selected" : "")>Medium</option>
                                        <option value="High" @(a.Priority == "High" ? "selected" : "")>High</option>
                                        <option value="Urgent" @(a.Priority == "Urgent" ? "selected" : "")>Urgent</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold small">Announcement Content *</label>
                                    <textarea name="Content" class="form-control" rows="4" required>@a.Content</textarea>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="actCheck_@a.Id" @(a.IsActive ? "checked" : "") />
                                        <input type="hidden" name="IsActive" value="false" />
                                        <label class="form-check-label small fw-semibold" for="actCheck_@a.Id">Active and Published</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary fw-bold">Update Announcement</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Create Notice Modal -->
<div class="modal fade" id="createNoticeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("CreateAnnouncement", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-bullhorn text-primary me-2"></i> Publish Campus Announcement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold small">Announcement Title *</label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. Campus Spring Festival 2026 Dates" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Category *</label>
                            <select name="Category" class="form-select" required>
                                <option value="Academic">Academic</option>
                                <option value="Examination">Examination</option>
                                <option value="Event">Event</option>
                                <option value="Administrative">Administrative</option>
                                <option value="Holiday">Holiday</option>
                                <option value="Urgent">Urgent / Emergency</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Target Audience</label>
                            <select name="TargetRole" class="form-select">
                                <option value="All" selected>All Campus Users</option>
                                <option value="Student">Students Only</option>
                                <option value="Faculty">Faculty Only</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Priority Level</label>
                            <select name="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Notice Content *</label>
                            <textarea name="Content" class="form-control" rows="4" placeholder="Enter the official details of this circular..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Publish Notice</button>
                </div>
            }
        </div>
    </div>
</div>
