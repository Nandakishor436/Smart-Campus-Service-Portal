@model List<Smart_Campus_Service_Portal.Models.CampusFeedback>
@{
    ViewBag.Title = "Student Service Feedback";
}

<div class="page-header">
    <div class="page-title">
        <h2>Student Service Feedback & Reviews</h2>
        <p>Ratings and reviews submitted by students for campus services</p>
    </div>
</div>

<div class="card-panel">
    <div class="card-panel-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var fb in Model)
                {
                    <div class="list-group-item p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="fw-bold mb-0 text-dark">@fb.ServiceName</h5>
                            <div class="text-warning fs-6">
                                @for (int i = 0; i < fb.Rating; i++)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                @for (int i = fb.Rating; i < 5; i++)
                                {
                                    <i class="fa-regular fa-star text-muted"></i>
                                }
                            </div>
                        </div>
                        <span class="badge bg-light text-dark border mb-2">@fb.Category</span>
                        <p class="text-secondary small mb-2">@fb.Comments</p>
                        <small class="text-muted">Reviewed by <strong>@fb.StudentName</strong> on @fb.CreatedAt.ToString("MMMM dd, yyyy")</small>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-star-half-stroke text-muted display-4 mb-3"></i>
                <h5 class="fw-bold">No feedback received yet</h5>
                <p class="text-muted small">Reviews submitted by students will appear here.</p>
            </div>
        }
    </div>
</div>
